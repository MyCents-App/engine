# Copy to docker/.env and fill in.  cp .env.example .env

# --- required: paths on the HOST machine -----------------------------------
# The SuryaOCR project (the receipt_ocr package). It lives on the `suryaOCR`
# branch of this repo — materialize it next to the checkout with:
#     git fetch origin suryaOCR && git worktree add ../SuryaOCR suryaOCR
# then point this at that absolute path.
SURYA_PROJECT_PATH=../SuryaOCR
# Directory CONTAINING the checkpoint folder; mounted read-only at /models.
# If the checkpoint is /opt/mycents/models/qwen3.5-2b-qlora/checkpoint-550
# then CHECKPOINT_PATH=/opt/mycents/models
CHECKPOINT_PATH=/opt/mycents/models
ENGINE_CHECKPOINT=/models/qwen3.5-2b-qlora/checkpoint-550

# --- required: auth --------------------------------------------------------
# Shared secret the client sends as `X-API-Key`. Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this empty disables auth entirely — never do that behind a tunnel.
ENGINE_API_KEY=

# --- optional --------------------------------------------------------------
ENGINE_PORT=8000
OCR_DEVICE=cuda            # 'cpu' works but costs ~20s/page instead of ~3.5s
ENGINE_MAX_SEQ_LENGTH=2048 # raise only if the GPU has VRAM to spare
ENGINE_MAX_NEW_TOKENS=768
ENGINE_MAX_PAGES=5
ENGINE_APPLY_DISCOUNT=1

# --- tunnel (only with `--profile tunnel`) ---------------------------------
NGROK_AUTHTOKEN=
# Reserved domain, e.g. mycents-engine.ngrok.app. Strongly recommended:
# without it the public URL changes on every restart.
NGROK_DOMAIN=
