# Copy to .env and adjust as needed. All values shown are the defaults.

# --- Surya's own GPU batch sizes (tuned here for a 12GB card) ---
# Surya's built-in defaults (512 / 36) target ~20GB / ~16GB VRAM and will OOM
# a 12GB card. Raise these if you have more VRAM headroom, lower them if you
# still hit CUDA out-of-memory errors.
RECOGNITION_BATCH_SIZE=96
DETECTOR_BATCH_SIZE=8

# Force a specific torch device, e.g. cuda / cpu. Leave unset to auto-detect.
# TORCH_DEVICE=cuda

# --- preprocessing ---
RECEIPT_OCR_MAX_LONG_SIDE=2560
RECEIPT_OCR_MIN_LONG_SIDE=1000
RECEIPT_OCR_CLAHE_CLIP=2.0

# --- orientation fallback (for scans with missing/wrong EXIF rotation) ---
# Off (0) by default -- tested and found unreliable enough to occasionally
# flip an already-upright image (see engine.py / config.py comments). EXIF
# correction alone (always on) covers the vast majority of real photos.
# Set to 1 only if you've confirmed this helps on your own data.
RECEIPT_OCR_ORIENTATION_FALLBACK=0

# --- row reconstruction (keeping item name + price together) ---
RECEIPT_OCR_ROW_Y_OVERLAP=0.4
RECEIPT_OCR_ROW_GAP_MULT=3.0

# --- quality flags ---
RECEIPT_OCR_LOW_CONFIDENCE=0.5
# Receipts have no legitimate math notation; keep math mode off (0).
RECEIPT_OCR_MATH_MODE=0

# --- batching ---
RECEIPT_OCR_MAX_BATCH=16
RECEIPT_OCR_OOM_DIVISOR=2
