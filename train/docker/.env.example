# Copy to docker/.env and fill in.  cp .env.example .env

# --- required: paths on the HOST machine -----------------------------------
# The SuryaOCR project (the receipt_ocr package). On this branch it is already
# in the repo, one level up from train/ — and paths here resolve relative to
# docker-compose.yml, hence two levels. Only change this if the two projects
# are not checked out side by side.
SURYA_PROJECT_PATH=../../SuryaOCR
# Directory CONTAINING the checkpoint folder; mounted read-only at /models.
# If the checkpoint is /opt/mycents/models/qwen3.5-2b-joint/checkpoint-125
# then CHECKPOINT_PATH=/opt/mycents/models
CHECKPOINT_PATH=/opt/mycents/models
ENGINE_CHECKPOINT=/models/qwen3.5-2b-joint/checkpoint-125

# --- required: auth --------------------------------------------------------
# Shared secret the client sends as `X-API-Key`. Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this empty disables auth entirely — never do that behind a tunnel.
ENGINE_API_KEY=

# --- optional --------------------------------------------------------------
ENGINE_PORT=8000
OCR_DEVICE=cuda            # 'cpu' works but costs ~20s/page instead of ~3.5s
ENGINE_MAX_SEQ_LENGTH=4096 # prompt budget = this minus MAX_NEW_TOKENS. 2048
                           # leaves ~1280, which a multi-photo receipt clears
ENGINE_MAX_NEW_TOKENS=1024    # the joint answer runs ~33 tokens/item; 768 cuts off ~23 items
ENGINE_EMIT_SUBCATEGORY=0  # 1 once a checkpoint reaches 90% subcategory precision
ENGINE_MAX_PAGES=5         # photos accepted as pages of ONE receipt
ENGINE_STITCH_PAGES=1      # drop the overlap between consecutive photos
ENGINE_APPLY_DISCOUNT=1
ENGINE_ALLOW_ORIGIN=*      # narrow once there is a real frontend origin
ENGINE_WARMUP=1

# --- tunnel (only with `--profile tunnel`) ---------------------------------
NGROK_AUTHTOKEN=
# Reserved domain, e.g. mycents-engine.ngrok.app. Strongly recommended:
# without it the public URL changes on every restart.
NGROK_DOMAIN=
